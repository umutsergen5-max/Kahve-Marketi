      "info": "t:sections.hero.settings.autoplay.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:sections.hero.settings.loop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "t:sections.hero.settings.show_controls.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.hero.settings.header__size.content"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.settings.height.label",
      "options": [
        {
          "value": "auto",
          "label": "t:sections.hero.settings.height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.hero.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.hero.settings.height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.hero.settings.height.options__4.label"
        },
        {
          "value": "full",
          "label": "t:sections.hero.settings.height.options__5.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "t:sections.hero.settings.mobile_height.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.hero.settings.mobile_height.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.hero.settings.mobile_height.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.hero.settings.mobile_height.options__3.label"
        },
        {
          "value": "full",
          "label": "t:sections.hero.settings.mobile_height.options__4.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:sections.hero.settings.header__content.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:sections.hero.settings.heading_level.label",
      "info": "t:sections.hero.settings.heading_level.info",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.hero.settings.heading_level.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.hero.settings.heading_level.options__2.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.hero.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
