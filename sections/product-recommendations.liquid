{%- comment -%}
  Product recommendations, powered by Shopify's recommendation engine (no product
  relationships are hardcoded). The section renders as an empty shell; assets/product-page.js
  ("product-recommendations" component) requests this same section from
  routes.product_recommendations_url once it is near the viewport. Shopify then renders the
  section again with the `recommendations` object filled in, and the cards are swapped in.
  With no recommendations the section stays hidden. Cards are the shared product-card snippet,
  shown as a swipeable carousel or a grid.
  In the theme editor placeholder cards are shown so the layout can be styled.
{%- endcomment -%}
{%- liquid
  assign col_count = section.settings.columns
  assign col_count_mobile = section.settings.columns_mobile
  assign as_carousel = false
  if section.settings.layout == 'carousel'
    assign as_carousel = true
  endif
  assign pv_mobile = 1.15
  if col_count_mobile == 2
    assign pv_mobile = 2.15
  endif
  assign tablet_count = col_count | at_most: 3
  assign heading_text = 'products.recommendations' | t
  if section.settings.heading != blank
    assign heading_text = section.settings.heading
  endif
  assign has_products = false
  if recommendations.performed and recommendations.products_count > 0
    assign has_products = true
  endif
  assign card_sizes = '(min-width: 1024px) calc(100vw / ' | append: col_count | append: '), (min-width: 768px) 33vw, 80vw'
  assign request_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.products_to_show | append: '&intent=' | append: section.settings.intent
-%}

<section
  class="product-recommendations section scheme-{{ section.settings.color_scheme }}"
  data-component="product-recommendations"
  data-url="{{ request_url }}"
  data-design-mode="{{ request.design_mode }}"
  data-spacing-top="{{ section.settings.spacing_top }}"
  data-spacing-bottom="{{ section.settings.spacing_bottom }}"
  {% unless has_products or request.design_mode %}hidden{% endunless %}
>
  <div class="section__header text-{{ section.settings.heading_align }}">
    <h2 class="heading heading--section">{{ heading_text | escape }}</h2>
  </div>

  <div data-recommendations-body>
    {%- capture cards -%}
      {%- if has_products -%}
        {%- for recommended in recommendations.products limit: section.settings.products_to_show -%}
          {%- if as_carousel -%}<div class="carousel__slide" data-carousel-slide role="group" aria-roledescription="{{ 'carousel.slide' | t | downcase }}" aria-label="{{ 'carousel.slide_of' | t: current: forloop.index, total: forloop.length }}">{%- endif -%}
          {% render 'product-card',
            product: recommended,
            image_ratio: settings.card_image_ratio,
            show_quick_add: section.settings.show_quick_add,
            sizes: card_sizes,
            heading_tag: 'h3'
          %}
          {%- if as_carousel -%}</div>{%- endif -%}
        {%- endfor -%}
      {%- elsif request.design_mode -%}
        {%- for i in (1..col_count) -%}
          {%- if as_carousel -%}<div class="carousel__slide" data-carousel-slide>{%- endif -%}
          {% render 'product-card', product: blank, image_ratio: settings.card_image_ratio, heading_tag: 'h3' %}
          {%- if as_carousel -%}</div>{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if as_carousel -%}
      <div
        class="carousel product-recommendations__carousel"
        data-component="carousel"
        style="--pv-mobile: {{ pv_mobile }}; --pv-tablet: 3; --pv-desktop: {{ col_count }}; --carousel-button-top: 35%;"
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ heading_text | escape }}"
      >
        <div class="carousel__track" data-carousel-track tabindex="0" id="track-{{ section.id }}">{{ cards }}</div>
        <button class="carousel__button carousel__button--prev" type="button" data-carousel-prev aria-controls="track-{{ section.id }}" aria-label="{{ 'carousel.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 20 %}</button>
        <button class="carousel__button carousel__button--next" type="button" data-carousel-next aria-controls="track-{{ section.id }}" aria-label="{{ 'carousel.next' | t }}">{% render 'icon', name: 'chevron-right', size: 20 %}</button>
        <div class="carousel__dots" data-carousel-dots role="group" aria-label="{{ 'carousel.slides_nav' | t }}"></div>
      </div>
    {%- else -%}
      <div class="grid product-recommendations__grid" style="--cols: {{ col_count }}; --cols-tablet: {{ tablet_count }}; --cols-mobile: {{ col_count_mobile }};">{{ cards }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.product-recommendations.name",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product-recommendations.settings.heading.label",
      "info": "t:sections.product-recommendations.settings.heading.info"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:sections.product-recommendations.settings.heading_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.product-recommendations.settings.heading_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.product-recommendations.settings.heading_align.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.product-recommendations.settings.intent.label",
      "info": "t:sections.product-recommendations.settings.intent.info",
      "options": [
        {
          "value": "related",
          "label": "t:sections.product-recommendations.settings.intent.options__1.label"
        },
        {
          "value": "complementary",
          "label": "t:sections.product-recommendations.settings.intent.options__2.label"
        }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product-recommendations.settings.products_to_show.label",
      "default": 4,
      "min": 2,
      "max": 10,
      "step": 1
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.product-recommendations.settings.layout.label",
      "options": [
        {
          "value": "carousel",
          "label": "t:sections.product-recommendations.settings.layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.product-recommendations.settings.layout.options__2.label"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.product-recommendations.settings.columns.label",
      "default": 4,
      "min": 2,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:sections.product-recommendations.settings.columns_mobile.label",
      "default": 1,
      "min": 1,
      "max": 2,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.product-recommendations.settings.show_quick_add.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.product-recommendations.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.product-recommendations.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.product-recommendations.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.product-recommendations.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.product-recommendations.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.product-recommendations.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.product-recommendations.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.product-recommendations.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.product-recommendations.settings.spacing_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.product-recommendations.settings.spacing_top.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.product-recommendations.settings.spacing_top.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.product-recommendations.settings.spacing_top.options__3.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.product-recommendations.settings.spacing_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.product-recommendations.settings.spacing_bottom.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.product-recommendations.settings.spacing_bottom.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.product-recommendations.settings.spacing_bottom.options__3.label"
        }
      ],
      "default": "full"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product-recommendations.presets.name"
    }
  ]
}
{% endschema %}
