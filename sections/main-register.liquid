{%- comment -%}
  Customer registration (customers/register template) — classic customer accounts.
  Native create_customer form: first name, last name, email, password. Shopify redirects on
  success (to the account page, or to an email confirmation step when the store requires it).
  Errors are summarised and the invalid fields refer to the summary.
{%- endcomment -%}
{%- assign register_title = 'customer.register' | t -%}
<section class="auth section scheme-{{ section.settings.color_scheme }}" data-spacing-top="{{ section.settings.spacing_top }}" data-spacing-bottom="{{ section.settings.spacing_bottom }}">
  <div class="auth__inner">
    {%- if section.settings.show_breadcrumb -%}<div class="auth__crumbs">{% render 'breadcrumbs', current_title: register_title %}</div>{%- endif -%}
    <h1 class="auth__title heading heading--section">{{ register_title }}</h1>

    {%- form 'create_customer', id: 'create-customer', novalidate: 'novalidate' -%}
      {% render 'form-errors', errors: form.errors, id: 'create-customer-errors' %}
      {% render 'form-field', id: 'register-first-name', name: 'customer[first_name]', label_key: 'customer.first_name', value: form.first_name, autocomplete: 'given-name', errors: form.errors, field: 'first_name', summary_id: 'create-customer-errors' %}
      {% render 'form-field', id: 'register-last-name', name: 'customer[last_name]', label_key: 'customer.last_name', value: form.last_name, autocomplete: 'family-name', errors: form.errors, field: 'last_name', summary_id: 'create-customer-errors' %}
      {% render 'form-field', id: 'register-email', name: 'customer[email]', type: 'email', label_key: 'customer.email', value: form.email, autocomplete: 'email', is_required: true, errors: form.errors, field: 'email', summary_id: 'create-customer-errors' %}
      {% render 'form-field', id: 'register-password', name: 'customer[password]', type: 'password', label_key: 'customer.password', autocomplete: 'new-password', is_required: true, errors: form.errors, field: 'password', summary_id: 'create-customer-errors' %}
      <button class="button auth__submit" type="submit">{{ 'customer.register_submit' | t }}</button>
    {%- endform -%}
    <p class="auth__alt text-small">
      {{ 'customer.have_account' | t }}
      <a class="link" href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "enabled_on": {
    "templates": [
      "customers/register"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.main-register.settings.show_breadcrumb.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main-register.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.main-register.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.main-register.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.main-register.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.main-register.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.main-register.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.main-register.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.main-register.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.main-register.settings.spacing_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-register.settings.spacing_top.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.main-register.settings.spacing_top.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.main-register.settings.spacing_top.options__3.label"
        }
      ],
      "default": "half"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.main-register.settings.spacing_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-register.settings.spacing_bottom.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.main-register.settings.spacing_bottom.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.main-register.settings.spacing_bottom.options__3.label"
        }
      ],
      "default": "full"
    }
  ]
}
{% endschema %}
