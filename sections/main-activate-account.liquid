{%- comment -%}
  Activate account (customers/activate_account template): reached from the invitation email.
  Native activate_customer_password form with an explicit "decline invitation" submit.
{%- endcomment -%}
<section class="auth section scheme-{{ section.settings.color_scheme }}" data-spacing-top="{{ section.settings.spacing_top }}" data-spacing-bottom="{{ section.settings.spacing_bottom }}">
  <div class="auth__inner">
    <h1 class="auth__title heading heading--section">{{ 'customer.activate_title' | t }}</h1>
    <p class="auth__text text-small text-muted">{{ 'customer.activate_text' | t }}</p>
    {%- form 'activate_customer_password', id: 'activate-account', novalidate: 'novalidate' -%}
      {% render 'form-errors', errors: form.errors, id: 'activate-account-errors' %}
      {% render 'form-field', id: 'activate-password', name: 'customer[password]', type: 'password', label_key: 'customer.password', autocomplete: 'new-password', is_required: true, errors: form.errors, field: 'password', summary_id: 'activate-account-errors' %}
      {% render 'form-field', id: 'activate-password-confirm', name: 'customer[password_confirmation]', type: 'password', label_key: 'customer.confirm_password', autocomplete: 'new-password', is_required: true, errors: form.errors, field: 'password_confirmation', summary_id: 'activate-account-errors' %}
      <div class="auth__actions">
        <button class="button auth__submit" type="submit">{{ 'customer.activate_submit' | t }}</button>
        <button class="button button--secondary" type="submit" name="decline">{{ 'customer.activate_decline' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-activate-account.name",
  "enabled_on": {
    "templates": [
      "customers/activate_account"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-activate-account.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.main-activate-account.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.main-activate-account.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.main-activate-account.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.main-activate-account.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.main-activate-account.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.main-activate-account.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.main-activate-account.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.main-activate-account.settings.spacing_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-activate-account.settings.spacing_top.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.main-activate-account.settings.spacing_top.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.main-activate-account.settings.spacing_top.options__3.label"
        }
      ],
      "default": "half"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.main-activate-account.settings.spacing_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-activate-account.settings.spacing_bottom.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.main-activate-account.settings.spacing_bottom.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.main-activate-account.settings.spacing_bottom.options__3.label"
        }
      ],
      "default": "full"
    }
  ]
}
{% endschema %}
