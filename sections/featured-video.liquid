{%- comment -%}
  Featured video: an eyebrow/heading/text intro (same pattern as featured-text) above a
  contained, framed video player — for a brand or "meet us" style video, not a full-bleed
  background. Unlike the hero section this always shows native player controls and never
  autoplays, so it stays simple and accessible. Shopify-hosted video only (type "video"),
  rendered with the video_tag filter (handles sources/poster/sizes on its own).
{%- endcomment -%}
{%- liquid
  assign heading_tag = section.settings.heading_level | default: 'h2'
  assign video = section.settings.video
  assign poster = section.settings.cover_image | default: video.preview_image
-%}
<section
  class="featured-video section scheme-{{ section.settings.color_scheme }}"
  data-spacing-top="{{ section.settings.spacing_top }}"
  data-spacing-bottom="{{ section.settings.spacing_bottom }}"
>
  <div class="featured-video__inner" style="--video-width: var(--width-{{ section.settings.content_width }});">
    {%- if section.settings.overline != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="featured-video__intro featured-video__intro--{{ section.settings.text_align }}">
        {%- if section.settings.overline != blank -%}<p class="overline featured-video__overline">{{ section.settings.overline | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="featured-video__heading heading heading--featured">{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}<div class="featured-video__text rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="featured-video__player media media--{{ section.settings.aspect_ratio }}">
      {%- if video != blank -%}
        {{ video | video_tag: image_size: '1600x', controls: true, poster: poster, class: 'featured-video__video' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="featured-video__caption text-small">{{ section.settings.caption | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .featured-video__inner { display: flex; flex-direction: column; align-items: center; gap: var(--space-24); }
  .featured-video__intro { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-16); max-width: var(--width-sm); margin-inline: auto; }
  .featured-video__intro--center { align-items: center; text-align: center; }
  .featured-video__overline, .featured-video__heading { margin: 0; }
  .featured-video__overline { color: var(--scheme-text-muted); }

  .featured-video__player { width: 100%; max-width: var(--video-width, var(--width-lg)); margin-inline: auto; background: var(--color-background-dark); }
  .featured-video__player > video { background: #000; }

  .featured-video__caption { margin: 0; max-width: var(--video-width, var(--width-lg)); color: var(--scheme-text-muted); text-align: center; }
{% endstylesheet %}

