{%- comment -%}
  Reset password (customers/reset_password template): reached from the link in Shopify's
  password-reset email. Native reset_customer_password form.
{%- endcomment -%}
<section class="auth section scheme-{{ section.settings.color_scheme }}" data-spacing-top="{{ section.settings.spacing_top }}" data-spacing-bottom="{{ section.settings.spacing_bottom }}">
  <div class="auth__inner">
    <h1 class="auth__title heading heading--section">{{ 'customer.reset_title' | t }}</h1>
    <p class="auth__text text-small text-muted">{{ 'customer.reset_text' | t: email: email }}</p>
    {%- form 'reset_customer_password', id: 'reset-password', novalidate: 'novalidate' -%}
      {% render 'form-errors', errors: form.errors, id: 'reset-password-errors' %}
      {% render 'form-field', id: 'reset-password-new', name: 'customer[password]', type: 'password', label_key: 'customer.new_password', autocomplete: 'new-password', is_required: true, errors: form.errors, field: 'password', summary_id: 'reset-password-errors' %}
      {% render 'form-field', id: 'reset-password-confirm', name: 'customer[password_confirmation]', type: 'password', label_key: 'customer.confirm_password', autocomplete: 'new-password', is_required: true, errors: form.errors, field: 'password_confirmation', summary_id: 'reset-password-errors' %}
      <button class="button auth__submit" type="submit">{{ 'customer.reset_submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-reset-password.name",
  "enabled_on": {
    "templates": [
      "customers/reset_password"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-reset-password.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.main-reset-password.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.main-reset-password.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.main-reset-password.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.main-reset-password.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.main-reset-password.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.main-reset-password.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.main-reset-password.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.main-reset-password.settings.spacing_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-reset-password.settings.spacing_top.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.main-reset-password.settings.spacing_top.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.main-reset-password.settings.spacing_top.options__3.label"
        }
      ],
      "default": "half"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.main-reset-password.settings.spacing_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-reset-password.settings.spacing_bottom.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.main-reset-password.settings.spacing_bottom.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.main-reset-password.settings.spacing_bottom.options__3.label"
        }
      ],
      "default": "full"
    }
  ]
}
{% endschema %}
