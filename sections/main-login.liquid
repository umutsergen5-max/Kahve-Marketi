{%- comment -%}
  Customer login (customers/login template) — classic customer accounts.
  Two native Shopify forms on one page: sign in (customer_login) and "forgot password"
  (recover_customer_password). Without JavaScript both are visible; with JS the recovery form
  replaces the sign-in form when "Forgot password?" is chosen (and after a recovery request,
  through the #recover anchor Shopify redirects to). Errors are shown in a summary that the
  invalid fields refer to. Password visibility toggle is progressive (assets/auth.js).
  With Shopify's new customer accounts this template is not used (Shopify hosts the login).
{%- endcomment -%}
{%- assign login_title = 'customer.login' | t -%}
<section class="auth section scheme-{{ section.settings.color_scheme }}" data-component="auth-panels" data-spacing-top="{{ section.settings.spacing_top }}" data-spacing-bottom="{{ section.settings.spacing_bottom }}">
  <div class="auth__inner">
    {%- if section.settings.show_breadcrumb -%}<div class="auth__crumbs">{% render 'breadcrumbs', current_title: login_title %}</div>{%- endif -%}
    <h1 class="auth__title heading heading--section">{{ login_title }}</h1>

    <div class="auth__panel" id="login" data-auth-panel="login">
      {%- form 'customer_login', id: 'customer-login', novalidate: 'novalidate' -%}
        {% render 'form-errors', errors: form.errors, id: 'customer-login-errors' %}
        {% render 'form-field', id: 'customer-login-email', name: 'customer[email]', type: 'email', label_key: 'customer.email', value: form.email, autocomplete: 'email', is_required: true, errors: form.errors, field: 'email', summary_id: 'customer-login-errors' %}
        {% render 'form-field', id: 'customer-login-password', name: 'customer[password]', type: 'password', label_key: 'customer.password', autocomplete: 'current-password', is_required: true, errors: form.errors, field: 'password', summary_id: 'customer-login-errors' %}
        <p class="auth__links"><a class="link" href="#recover" data-auth-toggle="recover">{{ 'customer.forgot_password' | t }}</a></p>
        <button class="button auth__submit" type="submit">{{ 'customer.login_submit' | t }}</button>
      {%- endform -%}
      <p class="auth__alt text-small">
        {{ 'customer.no_account' | t }}
        <a class="link" href="{{ routes.account_register_url }}">{{ 'customer.register' | t }}</a>
      </p>
    </div>

    <div class="auth__panel" id="recover" data-auth-panel="recover">
      <h2 class="auth__subtitle heading heading--block">{{ 'customer.recover_title' | t }}</h2>
      {%- form 'recover_customer_password', id: 'recover-password', novalidate: 'novalidate' -%}
        {%- if form.posted_successfully? -%}
          <p class="message message--success" role="status" tabindex="-1" data-auth-success>{{ 'customer.recover_success' | t }}</p>
        {%- else -%}
          <p class="auth__text text-small text-muted">{{ 'customer.recover_text' | t }}</p>
          {% render 'form-errors', errors: form.errors, id: 'recover-errors' %}
          {% render 'form-field', id: 'recover-email', name: 'email', type: 'email', label_key: 'customer.email', value: form.email, autocomplete: 'email', is_required: true, errors: form.errors, field: 'email', summary_id: 'recover-errors' %}
          <button class="button auth__submit" type="submit">{{ 'customer.recover_submit' | t }}</button>
        {%- endif -%}
      {%- endform -%}
      <p class="auth__alt text-small"><a class="link" href="#login" data-auth-toggle="login">{{ 'customer.back_to_login' | t }}</a></p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "enabled_on": {
    "templates": [
      "customers/login"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.main-login.settings.show_breadcrumb.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main-login.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.main-login.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.main-login.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.main-login.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.main-login.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.main-login.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.main-login.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.main-login.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.main-login.settings.spacing_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-login.settings.spacing_top.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.main-login.settings.spacing_top.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.main-login.settings.spacing_top.options__3.label"
        }
      ],
      "default": "half"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.main-login.settings.spacing_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-login.settings.spacing_bottom.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.main-login.settings.spacing_bottom.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.main-login.settings.spacing_bottom.options__3.label"
        }
      ],
      "default": "full"
    }
  ]
}
{% endschema %}
