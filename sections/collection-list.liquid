      "min": 8,
      "max": 48,
      "step": 4
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header__cards.content"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.collection-list.settings.card_style.label",
      "options": [
        {
          "value": "below",
          "label": "t:sections.collection-list.settings.card_style.options__1.label"
        },
        {
          "value": "overlay",
          "label": "t:sections.collection-list.settings.card_style.options__2.label"
        }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.collection-list.settings.image_ratio.label",
      "options": [
        {
          "value": "portrait",
