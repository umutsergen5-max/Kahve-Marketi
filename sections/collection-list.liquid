    {
      "type": "select",
      "id": "heading_align",
      "label": "t:sections.collection-list.settings.heading_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.collection-list.settings.heading_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.collection-list.settings.heading_align.options__2.label"
        }
