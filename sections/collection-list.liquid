{%- comment -%}
  Collections index (list-collections template): every collection of the store.
  Two layouts:
  - cards: a grid of collection cards (shared collection-card snippet)
  - rows: one row per collection with its heading and first products (shared product-card),
          which is how the reference presents its collections page
  Collections are managed in Shopify; nothing is hardcoded. Standard pagination.
{%- endcomment -%}
{%- liquid
  assign col_count = section.settings.columns
  assign col_count_mobile = section.settings.columns_mobile | plus: 0
  assign tablet_count = col_count | at_most: 3
  assign rows_layout = false
  if section.settings.layout == 'rows'
    assign rows_layout = true
  endif
  assign image_ratio = section.settings.image_ratio
  assign product_ratio = settings.card_image_ratio
-%}

{%- paginate collections by section.settings.collections_per_page -%}
  <section
    class="collection-list section scheme-{{ section.settings.color_scheme }}"
    data-spacing-top="{{ section.settings.spacing_top }}"
    data-spacing-bottom="{{ section.settings.spacing_bottom }}"
  >
    {%- if section.settings.heading != blank -%}
      <div class="section__header text-{{ section.settings.heading_align }}">
        <h1 class="heading heading--section">{{ section.settings.heading | escape }}</h1>
      </div>
    {%- else -%}
      <h1 class="visually-hidden">{{ 'collections.title' | t }}</h1>
    {%- endif -%}

    {%- if collections.size == 0 -%}
      <p>{{ 'collections.no_collections' | t }}</p>
    {%- elsif rows_layout -%}
      <div class="collection-list__rows">
        {%- for collection in collections -%}
          <div class="collection-list__row">
            <div class="collection-list__row-header">
              <h2 class="heading heading--featured collection-list__row-title"><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2>
              {%- if section.settings.show_view_all -%}
                <a class="button button--text text-nav" href="{{ collection.url }}">{{ 'general.view_all' | t }}<span class="visually-hidden"> — {{ collection.title | escape }}</span></a>
              {%- endif -%}
            </div>
            <div class="grid" style="--cols: {{ col_count }}; --cols-tablet: {{ tablet_count }}; --cols-mobile: {{ col_count_mobile }};">
              {%- for product in collection.products limit: section.settings.row_products -%}
                {% render 'product-card',
                  product: product,
                  image_ratio: product_ratio,
                  show_quick_add: true,
                  heading_tag: 'h3',
                  sizes: '(min-width: 1024px) calc(100vw / 4), (min-width: 768px) 33vw, 50vw'
                %}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid collection-list__grid" style="--cols: {{ col_count }}; --cols-tablet: {{ tablet_count }}; --cols-mobile: {{ col_count_mobile }};">
        {%- for collection in collections -%}
          {% render 'collection-card',
            collection: collection,
            style: section.settings.card_style,
            image_ratio: image_ratio,
            show_description: section.settings.show_description,
            overlay_opacity: section.settings.overlay_opacity,
            heading_tag: 'h2',
            loading: 'lazy',
            sizes: '(min-width: 1024px) calc(100vw / 4), (min-width: 768px) 33vw, 50vw'
          %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- render 'pagination', paginate: paginate -%}
  </section>
{%- endpaginate -%}

{% stylesheet %}
  .collection-list__grid { --gap-row: var(--space-32); }
  @media (min-width: 768px) { .collection-list__grid { --gap-row: var(--space-48); } }
  .collection-list__rows { display: flex; flex-direction: column; gap: var(--space-48); }
  .collection-list__row { display: flex; flex-direction: column; gap: var(--space-16); }
  .collection-list__row-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-8) var(--space-16); }
  .collection-list__row-title { margin: 0; }
  .collection-list__row-title a { text-decoration: none; }
  .collection-list__row-title a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
{% endstylesheet %}

{% schema %}
{
