{%- comment -%}
  Featured product: a real product chosen in the theme editor.
  Gallery (scroll-snap carousel + thumbnails + optional zoom), title, price, variant
  options, quantity, add to cart (AJAX through the cart drawer) and a link to the product.
  With no product selected, a placeholder layout is rendered so the merchant can see the design.
  Behaviour: assets/product.js (variants, gallery, zoom), assets/carousel.js, assets/cart-drawer.js.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  assign current_variant = product.selected_or_first_available_variant
  assign ratio = section.settings.gallery_ratio
  assign has_product = false
  assign first_priority = false
  if section.index <= 2
    assign first_priority = true
  endif
  if product
    assign has_product = true
  endif
  assign words = section.settings.description_words
-%}

<section
  class="featured-product section scheme-{{ section.settings.color_scheme }}"
  data-spacing-top="{{ section.settings.spacing_top }}"
  data-spacing-bottom="{{ section.settings.spacing_bottom }}"
>
  <div
    class="featured-product__layout featured-product__layout--{{ section.settings.media_position }} featured-product__layout--{{ section.settings.media_size }}"
    {% if has_product %}data-component="product-details" data-update-url="false"{% endif %}
  >
    <div class="featured-product__media">
      {%- if has_product -%}
        {% render 'product-gallery',
          product: product,
          section_id: section.id,
          ratio: ratio,
          show_thumbnails: section.settings.show_thumbnails,
          enable_zoom: section.settings.enable_zoom,
          first_priority: first_priority
        %}
      {%- else -%}
        <div class="media media--{{ ratio }}">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>

    <div class="featured-product__info">
      {%- if has_product -%}
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="overline featured-product__vendor">{{ product.vendor | escape }}</p>
        {%- endif -%}
        <h2 class="featured-product__title heading heading--featured">
          <a class="featured-product__title-link" href="{{ product.url }}">{{ product.title | escape }}</a>
        </h2>
        <div class="featured-product__price">{% render 'price', product: product, variant: current_variant %}</div>

        {%- if section.settings.show_description and product.description != blank -%}
          <p class="featured-product__description text-small">{{ product.description | strip_html | truncatewords: words }}</p>
        {%- endif -%}

        {% render 'product-form',
          product: product,
          section_id: section.id,
          option_style: section.settings.option_style,
          show_quantity: section.settings.show_quantity,
          show_dynamic_checkout: section.settings.show_dynamic_checkout
        %}

        {%- if section.settings.show_view_details -%}
          <a class="button button--text featured-product__details" href="{{ product.url }}">{{ 'products.view_details' | t }}</a>
        {%- endif -%}
      {%- else -%}
        <h2 class="featured-product__title heading heading--featured">{{ 'products.placeholder_title' | t }}</h2>
        <div class="featured-product__price"><div class="price"><span class="price__current">{{ 0 | money }}</span></div></div>
        <button class="button button--full" type="button" disabled>{{ 'products.add_to_cart' | t }}</button>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .featured-product__layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-32); align-items: start; }
  .featured-product__info { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-16); min-width: 0; }
  .featured-product__info > .product-form-wrap { width: 100%; }
  .featured-product__title, .featured-product__vendor, .featured-product__description { margin: 0; }
  .featured-product__title-link { text-decoration: none; }
  .featured-product__details { min-height: 44px; }
  .featured-product__title-link:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .featured-product__price { font-size: var(--fs-block); }
  .featured-product__description { color: var(--scheme-text-muted); max-width: 40rem; }

  /* Tablet (768-1023): stacked, with the gallery capped so it does not become huge. Desktop: two columns. */
  @media (min-width: 768px) {
    .featured-product__layout { gap: var(--space-48); }
    .featured-product__media { width: 100%; max-width: 560px; margin-inline: auto; }
  }
  @media (min-width: 1024px) {
    .featured-product__layout { grid-template-columns: minmax(0, var(--media-fr, 1.2fr)) minmax(0, 1fr); align-items: center; }
    .featured-product__media { max-width: none; margin-inline: 0; }
    .featured-product__layout--small  { --media-fr: 0.9fr; }
    .featured-product__layout--medium { --media-fr: 1.2fr; }
    .featured-product__layout--large  { --media-fr: 1.6fr; }
    .featured-product__layout--right .featured-product__media { order: 2; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured-product.name",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.featured-product.settings.product.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-product.settings.header__gallery.content"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:sections.featured-product.settings.media_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.featured-product.settings.media_position.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.featured-product.settings.media_position.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "t:sections.featured-product.settings.media_size.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.featured-product.settings.media_size.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.featured-product.settings.media_size.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.featured-product.settings.media_size.options__3.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "t:sections.featured-product.settings.gallery_ratio.label",
      "options": [
        {
          "value": "portrait",
          "label": "t:sections.featured-product.settings.gallery_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.featured-product.settings.gallery_ratio.options__2.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.featured-product.settings.gallery_ratio.options__3.label"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "t:sections.featured-product.settings.show_thumbnails.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "t:sections.featured-product.settings.enable_zoom.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.featured-product.settings.header__info.content"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.featured-product.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.featured-product.settings.show_description.label",
      "default": true
    },
    {
      "type": "range",
      "id": "description_words",
      "label": "t:sections.featured-product.settings.description_words.label",
      "default": 30,
      "min": 10,
      "max": 80,
      "step": 5
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:sections.featured-product.settings.show_quantity.label",
      "default": true
    },
    {
      "type": "select",
      "id": "option_style",
      "label": "t:sections.featured-product.settings.option_style.label",
      "options": [
        {
          "value": "pills",
          "label": "t:sections.featured-product.settings.option_style.options__1.label"
        },
        {
          "value": "dropdown",
          "label": "t:sections.featured-product.settings.option_style.options__2.label"
        }
      ],
      "default": "pills"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:sections.featured-product.settings.show_dynamic_checkout.label",
      "info": "t:sections.featured-product.settings.show_dynamic_checkout.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_details",
      "label": "t:sections.featured-product.settings.show_view_details.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.featured-product.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.featured-product.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.featured-product.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.featured-product.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.featured-product.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.featured-product.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.featured-product.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.featured-product.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.featured-product.settings.spacing_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.featured-product.settings.spacing_top.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.featured-product.settings.spacing_top.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.featured-product.settings.spacing_top.options__3.label"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.featured-product.settings.spacing_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.featured-product.settings.spacing_bottom.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.featured-product.settings.spacing_bottom.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.featured-product.settings.spacing_bottom.options__3.label"
        }
      ],
      "default": "full"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-product.presets.name"
    }
  ]
}
{% endschema %}
