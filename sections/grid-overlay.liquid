{%- comment -%}
  Image grid with text overlay. Each block is a tile (image, optional mobile image,
  overline, heading, text, link + button label, overlay strength, alignment).
  The merchant builds the layout by choosing the column count and each tile's span.
  A tile with a link becomes one big link; the button label is then presentational.
{%- endcomment -%}
{%- liquid
  assign col_count = section.settings.columns
  assign col_count_mobile = section.settings.columns_mobile
  assign ratio = section.settings.image_ratio
  assign gap = section.settings.gap
  assign tile_heading = 'h3'
  if section.settings.heading == blank
    assign tile_heading = 'h2'
  endif
-%}

<section
  class="grid-overlay section scheme-{{ section.settings.color_scheme }}{% if section.settings.full_width %} section--flush{% endif %}"
  data-spacing-top="{{ section.settings.spacing_top }}"
  data-spacing-bottom="{{ section.settings.spacing_bottom }}"
>
  {%- if section.settings.heading != blank -%}
    <div class="section__header{% if section.settings.full_width %} grid-overlay__header{% endif %}">
      <h2 class="heading heading--section">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="grid grid-overlay__grid grid-overlay__grid--gap-{{ gap }}" style="--cols: {{ col_count }}; --cols-mobile: {{ col_count_mobile }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign block_span = 1
        if block.settings.column_span == 'full'
          assign block_span = col_count
        elsif block.settings.column_span == '2'
          assign block_span = 2 | at_most: col_count
        endif
        assign span_mobile = 1
        if block.settings.mobile_full_width and col_count_mobile > 1
          assign span_mobile = col_count_mobile
        endif
        assign tile_image = block.settings.image
        assign tile_mobile = block.settings.image_mobile
        assign tile_tag = 'div'
        if block.settings.link != blank
          assign tile_tag = 'a'
        endif
        assign tile_loading = 'lazy'
        if section.index == 1 and forloop.index <= 2
          assign tile_loading = 'eager'
        endif
      -%}
      <{{ tile_tag }}
        class="tile tile--text-{{ block.settings.text_color }} tile--align-{{ block.settings.text_align }} tile--valign-{{ block.settings.vertical_align }}"
        style="--span: {{ block_span }}; --span-mobile: {{ span_mobile }};"
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="tile__media media{% if ratio != 'natural' %} media--{{ ratio }}{% else %} media--natural{% endif %}">
          {%- if tile_image != blank -%}
            <picture>
              {%- if tile_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ tile_mobile | image_url: width: 480 }} 480w, {{ tile_mobile | image_url: width: 768 }} 768w, {{ tile_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
              {%- endif -%}
              <img
                class="tile__image"
                src="{{ tile_image | image_url: width: 1200 }}"
                srcset="{{ tile_image | image_url: width: 480 }} 480w, {{ tile_image | image_url: width: 768 }} 768w, {{ tile_image | image_url: width: 1100 }} 1100w, {{ tile_image | image_url: width: 1600 }} 1600w"
                sizes="(min-width: 1024px) calc(100vw / {{ col_count }}), 100vw"
                width="{{ tile_image.width }}"
                height="{{ tile_image.height }}"
                alt="{{ tile_image.alt | escape }}"
                loading="{{ tile_loading }}"
              >
            </picture>
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="tile__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }}" aria-hidden="true"></span>
        </div>

        {%- if block.settings.overline != blank or block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
          <div class="tile__content">
            {%- if block.settings.overline != blank -%}
              <p class="overline tile__overline">{{ block.settings.overline | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <{{ tile_heading }} class="tile__heading heading heading--featured">{{ block.settings.heading | escape }}</{{ tile_heading }}>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="tile__text text-small">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="button button--light tile__button">{{ block.settings.button_label | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </{{ tile_tag }}>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .grid-overlay__grid--gap-none { --gap-row: 0px; --gap-column: 0px; }
  .grid-overlay__grid--gap-small { --gap-row: var(--space-8); --gap-column: var(--space-8); }
  .grid-overlay__header { padding-inline: var(--section-x); }

  .tile { position: relative; display: block; grid-column: span var(--span-mobile, 1); min-width: 0; color: #fff; text-decoration: none; }
  @media (min-width: 768px) { .tile { grid-column: span var(--span, 1); } }

  .tile__media { height: 100%; border-radius: var(--radius-image); }
  .grid-overlay__grid--gap-none .tile__media { border-radius: 0; }
  .tile__media picture { display: contents; }
  .tile__image { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease-out); }
  .media--natural .tile__image { height: auto; }
  .tile__overlay { position: absolute; inset: 0; background: #000; transition: opacity 0.4s var(--ease-standard); }

  .tile__content { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; justify-content: center; gap: var(--space-8); padding: var(--space-16); }
  .tile__heading, .tile__text, .tile__overline { margin: 0; }
  .tile__button { align-self: flex-start; margin-top: var(--space-8); }
  @media (min-width: 768px) { .tile__content { padding: var(--space-32); } }

  .tile--valign-top .tile__content    { justify-content: flex-start; }
  .tile--valign-center .tile__content { justify-content: center; }
  .tile--valign-bottom .tile__content { justify-content: flex-end; }
  .tile--align-left .tile__content   { align-items: flex-start; text-align: left; }
  .tile--align-center .tile__content { align-items: center; text-align: center; }
  .tile--align-center .tile__button  { align-self: center; }
  .tile--align-right .tile__content  { align-items: flex-end; text-align: right; }
  .tile--align-right .tile__button   { align-self: flex-end; }

  .tile--text-dark { color: var(--color-background-dark); }
  .tile--text-dark .tile__overlay { background: #fff; }
  .tile--text-dark .tile__button { --button-bg: var(--color-background-dark); --button-text: #fff; --button-border: var(--color-background-dark); }

  a.tile:focus-visible { outline: 2px solid var(--scheme-focus); outline-offset: 3px; }
  @media (hover: hover) {
    a.tile:hover .tile__image { transform: scale(1.04); }
    a.tile:hover .tile__overlay { filter: brightness(0.75); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.grid-overlay.name",
  "max_blocks": 12,
  "settings": [
