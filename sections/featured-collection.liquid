{%- comment -%}
  Featured collection: heading, optional description and products of a collection
  chosen in the theme editor, as a grid or a touch-friendly carousel.
  Uses the shared product-card snippet (also used by the collection pages in Phase 5).
  With no collection selected, placeholder cards show the layout.
{%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  assign product_limit = section.settings.products_to_show
  assign col_count = section.settings.columns
  assign col_count_mobile = section.settings.columns_mobile
  assign as_carousel = false
  if section.settings.layout == 'carousel'
    assign as_carousel = true
  endif
  assign pv_mobile = 1.15
  if col_count_mobile == 2
    assign pv_mobile = 2.15
  endif
  assign image_ratio = section.settings.image_ratio
  if image_ratio == 'default'
    assign image_ratio = settings.card_image_ratio
  endif
  assign product_list = collection.products
  assign card_heading = 'h3'
  if section.settings.heading == blank
    assign card_heading = 'h2'
  endif
  assign has_products = false
  if collection
    if product_list.size > 0
      assign has_products = true
    endif
  endif
  if section.settings.heading != blank
    assign carousel_label = section.settings.heading
  else
    assign carousel_label = 'carousel.label' | t
  endif
  assign card_sizes = '(min-width: 1024px) calc(100vw / ' | append: col_count | append: '), (min-width: 768px) 33vw, 80vw'
-%}

<section
  class="featured-collection section scheme-{{ section.settings.color_scheme }}"
  data-spacing-top="{{ section.settings.spacing_top }}"
  data-spacing-bottom="{{ section.settings.spacing_bottom }}"
>
  {%- if section.settings.heading != blank or section.settings.description != blank -%}
    <div class="section__header featured-collection__header text-{{ section.settings.heading_align }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="heading heading--section">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="featured-collection__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- capture cards -%}
    {%- if has_products -%}
      {%- for product in product_list limit: product_limit -%}
        {%- if as_carousel -%}<div class="carousel__slide" data-carousel-slide role="group" aria-roledescription="{{ 'carousel.slide' | t | downcase }}" aria-label="{{ 'carousel.slide_of' | t: current: forloop.index, total: forloop.length }}">{%- endif -%}
        {% render 'product-card',
          product: product,
          image_ratio: image_ratio,
          show_secondary_image: section.settings.show_secondary_image,
          show_quick_add: section.settings.show_quick_add,
          sizes: card_sizes,
          loading: 'lazy',
          heading_tag: card_heading,
          text_align: section.settings.card_align
        %}
        {%- if as_carousel -%}</div>{%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..col_count) -%}
        {%- if as_carousel -%}<div class="carousel__slide" data-carousel-slide>{%- endif -%}
        {% render 'product-card', product: blank, image_ratio: image_ratio, text_align: section.settings.card_align, heading_tag: card_heading %}
        {%- if as_carousel -%}</div>{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {%- if as_carousel -%}
    <div
      class="carousel featured-collection__carousel"
      data-component="carousel"
      style="--pv-mobile: {{ pv_mobile }}; --pv-tablet: 3; --pv-desktop: {{ col_count }}; --carousel-button-top: 35%;"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ carousel_label | escape }}"
    >
      <div class="carousel__track" data-carousel-track tabindex="0" id="track-{{ section.id }}">{{ cards }}</div>
      <button class="carousel__button carousel__button--prev" type="button" data-carousel-prev aria-controls="track-{{ section.id }}" aria-label="{{ 'carousel.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 20 %}</button>
      <button class="carousel__button carousel__button--next" type="button" data-carousel-next aria-controls="track-{{ section.id }}" aria-label="{{ 'carousel.next' | t }}">{% render 'icon', name: 'chevron-right', size: 20 %}</button>
    </div>
  {%- else -%}
    <div class="grid featured-collection__grid" style="--cols: {{ col_count }}; --cols-mobile: {{ col_count_mobile }}; --cols-tablet: {{ col_count | at_most: 3 }};">{{ cards }}</div>
  {%- endif -%}

  {%- if section.settings.show_view_all and collection -%}
    <div class="featured-collection__footer">
      <a class="button button--secondary" href="{{ collection.url }}">{{ 'general.view_all' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .featured-collection__header { display: flex; flex-direction: column; gap: var(--space-8); }
  .featured-collection__description { max-width: 40rem; color: var(--scheme-text-muted); }
  .featured-collection__header.text-center .featured-collection__description { margin-inline: auto; }
  .featured-collection__footer { display: flex; justify-content: center; margin-top: var(--space-32); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-collection.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:sections.featured-collection.settings.heading_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.featured-collection.settings.heading_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.featured-collection.settings.heading_align.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header__products.content"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured-collection.settings.products_to_show.label",
      "default": 8,
      "min": 2,
      "max": 24,
      "step": 1
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured-collection.settings.layout.label",
      "options": [
        {
          "value": "carousel",
          "label": "t:sections.featured-collection.settings.layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.featured-collection.settings.layout.options__2.label"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.featured-collection.settings.columns.label",
      "default": 4,
      "min": 2,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:sections.featured-collection.settings.columns_mobile.label",
      "default": 1,
      "min": 1,
      "max": 2,
      "step": 1
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header__card.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.featured-collection.settings.image_ratio.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.featured-collection.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.featured-collection.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.featured-collection.settings.image_ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.featured-collection.settings.image_ratio.options__4.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "card_align",
      "label": "t:sections.featured-collection.settings.card_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.featured-collection.settings.card_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.featured-collection.settings.card_align.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.featured-collection.settings.show_secondary_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.featured-collection.settings.show_quick_add.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured-collection.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.featured-collection.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.featured-collection.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.featured-collection.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.featured-collection.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.featured-collection.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.featured-collection.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.featured-collection.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.featured-collection.settings.spacing_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.featured-collection.settings.spacing_top.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.featured-collection.settings.spacing_top.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.featured-collection.settings.spacing_top.options__3.label"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.featured-collection.settings.spacing_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.featured-collection.settings.spacing_bottom.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.featured-collection.settings.spacing_bottom.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.featured-collection.settings.spacing_bottom.options__3.label"
        }
      ],
      "default": "full"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.name"
    }
  ]
}
{% endschema %}
