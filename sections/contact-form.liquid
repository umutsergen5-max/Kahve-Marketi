{%- comment -%}
  Contact / application form built on Shopify's native contact form (the form tag),
  so messages arrive in the store's customer-email inbox with Shopify's spam protection.
  No third-party form service is involved. Fields (name, email, phone, company, one custom
  field, message) can be switched on and off; the wholesale template uses it as an
  application form. Success and error states are announced to assistive technology.
{%- endcomment -%}
{%- liquid
  assign form_id = 'contact-form-' | append: section.id
  assign success_text = 'contact.success' | t
  if section.settings.success_message != blank
    assign success_text = section.settings.success_message
  endif
  assign button_text = 'contact.submit' | t
  if section.settings.button_label != blank
    assign button_text = section.settings.button_label
  endif
-%}
<section
  class="contact-form section scheme-{{ section.settings.color_scheme }}"
  data-spacing-top="{{ section.settings.spacing_top }}"
  data-spacing-bottom="{{ section.settings.spacing_bottom }}"
>
  <div class="contact-form__inner">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <header class="contact-form__header">
        {%- if section.settings.heading != blank -%}<h2 class="contact-form__heading heading heading--featured" id="{{ form_id }}-heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="contact-form__text rte">{{ section.settings.text }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    {%- form 'contact', id: form_id, class: 'contact-form__form', novalidate: 'novalidate' -%}
      {%- if form.posted_successfully? -%}
        <p class="message message--success" role="status" tabindex="-1" id="{{ form_id }}-status">{{ success_text | escape }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <div class="message message--error" role="alert" id="{{ form_id }}-errors">
            <p>{{ 'contact.error' | t }}</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="contact-form__fields">
          <div class="field">
            <label class="field__label" for="{{ form_id }}-name">{{ 'contact.name' | t }} <span class="visually-hidden">({{ 'general.required' | t }})</span></label>
            <input class="input" type="text" id="{{ form_id }}-name" name="contact[name]" value="{{ form.name }}" autocomplete="name" required aria-required="true"{% if form.errors contains 'name' %} aria-invalid="true"{% endif %}>
          </div>
          <div class="field">
            <label class="field__label" for="{{ form_id }}-email">{{ 'contact.email' | t }} <span class="visually-hidden">({{ 'general.required' | t }})</span></label>
            <input class="input" type="email" id="{{ form_id }}-email" name="contact[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" spellcheck="false" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
          </div>
          {%- if section.settings.show_phone -%}
            <div class="field">
              <label class="field__label" for="{{ form_id }}-phone">{{ 'contact.phone' | t }}</label>
              <input class="input" type="tel" id="{{ form_id }}-phone" name="contact[{{ 'contact.phone' | t }}]" value="{{ form.phone }}" autocomplete="tel">
            </div>
          {%- endif -%}
          {%- if section.settings.show_company -%}
            <div class="field">
              <label class="field__label" for="{{ form_id }}-company">{{ 'contact.company' | t }}</label>
              <input class="input" type="text" id="{{ form_id }}-company" name="contact[{{ 'contact.company' | t }}]" autocomplete="organization">
            </div>
          {%- endif -%}
          {%- if section.settings.extra_label != blank -%}
            <div class="field">
              <label class="field__label" for="{{ form_id }}-extra">{{ section.settings.extra_label | escape }}</label>
              <input class="input" type="text" id="{{ form_id }}-extra" name="contact[{{ section.settings.extra_label | escape }}]">
            </div>
          {%- endif -%}
          {%- if section.settings.show_message -%}
            <div class="field">
              <label class="field__label" for="{{ form_id }}-body">{{ 'contact.message' | t }}</label>
              <textarea class="textarea" id="{{ form_id }}-body" name="contact[body]" rows="5">{{ form.body }}</textarea>
            </div>
          {%- endif -%}
        </div>

        <button class="button contact-form__submit" type="submit"><span>{{ button_text | escape }}</span></button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .contact-form__inner { max-width: var(--width-xs); margin-inline: auto; }
  .contact-form__header { margin-bottom: var(--space-32); }
  .contact-form__heading { margin: 0; }
  .contact-form__text { margin-top: var(--space-12); }
  .contact-form__form { display: flex; flex-direction: column; gap: var(--space-32); }
  .contact-form__fields { display: flex; flex-direction: column; gap: var(--space-16); }
  .contact-form__submit { align-self: flex-start; }
  .contact-form .message ul { margin: var(--space-8) 0 0; padding-left: 1.2em; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.contact-form.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.contact-form.settings.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.contact-form.settings.header__fields.content"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "t:sections.contact-form.settings.show_phone.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_company",
      "label": "t:sections.contact-form.settings.show_company.label",
      "default": false
    },
    {
      "type": "text",
      "id": "extra_label",
      "label": "t:sections.contact-form.settings.extra_label.label",
      "info": "t:sections.contact-form.settings.extra_label.info"
    },
    {
      "type": "checkbox",
      "id": "show_message",
      "label": "t:sections.contact-form.settings.show_message.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.contact-form.settings.header__button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.contact-form.settings.button_label.label",
      "info": "t:sections.contact-form.settings.button_label.info"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:sections.contact-form.settings.success_message.label",
      "info": "t:sections.contact-form.settings.success_message.info"
    },
    {
      "type": "paragraph",
      "content": "t:sections.contact-form.settings.paragraph__info.content"
    },
    {
      "type": "header",
      "content": "t:sections.contact-form.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.contact-form.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.contact-form.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.contact-form.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.contact-form.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.contact-form.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.contact-form.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.contact-form.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.contact-form.settings.spacing_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.contact-form.settings.spacing_top.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.contact-form.settings.spacing_top.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.contact-form.settings.spacing_top.options__3.label"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.contact-form.settings.spacing_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.contact-form.settings.spacing_bottom.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.contact-form.settings.spacing_bottom.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.contact-form.settings.spacing_bottom.options__3.label"
        }
      ],
      "default": "full"
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
