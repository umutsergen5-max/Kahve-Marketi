{%- comment -%}
  Editorial slideshow: a swipeable row of image + text cards. Deliberately generic — use it
  for stores, showrooms, service points, brand stories, playlists, guides or any editorial
  content. Nothing assumes a physical location or a particular platform.

  Slide (block): image, title, text, optional address, optional link with button label,
  optional icon, "open in new tab" for external links.
  Card style: "below" (text under the image) or "overlay" (text over the image).
{%- endcomment -%}
{%- liquid
  assign per_view = section.settings.slides_per_view
  assign card_style = section.settings.card_style
  assign ratio = section.settings.image_ratio
  assign pv_mobile = 1.15
  assign tablet_view = per_view | at_most: 2
  if section.blocks.size > 0
    assign has_slides = true
  else
    assign has_slides = false
  endif
  assign slide_total = section.blocks.size | at_least: 3
  assign slide_heading = 'h3'
  if section.settings.heading == blank
    assign slide_heading = 'h2'
  endif
  if section.settings.heading != blank
    assign carousel_label = section.settings.heading
  else
    assign carousel_label = 'carousel.label' | t
  endif
-%}

<section
  class="editorial-slideshow section scheme-{{ section.settings.color_scheme }}"
  data-spacing-top="{{ section.settings.spacing_top }}"
  data-spacing-bottom="{{ section.settings.spacing_bottom }}"
>
  {%- if section.settings.heading != blank -%}
    <div class="section__header text-{{ section.settings.heading_align }}">
      <h2 class="heading heading--section">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div
    class="carousel editorial-slideshow__carousel"
    data-component="carousel"
    data-slide-step="1"
    style="--pv-mobile: {{ pv_mobile }}; --pv-tablet: {{ tablet_view }}; --pv-desktop: {{ per_view }}; {% if card_style == 'below' %}--carousel-button-top: 35%;{% endif %}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ carousel_label | escape }}"
  >
    <div class="carousel__track" data-carousel-track tabindex="0" id="track-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign slide_image = block.settings.image
          assign has_link = false
          if block.settings.link != blank
            assign has_link = true
          endif
          assign icon = block.settings.icon
          assign slide_loading = 'lazy'
          if section.index == 1 and forloop.index <= 2
            assign slide_loading = 'eager'
          endif
          assign new_tab = block.settings.open_new_tab
        -%}
        <article
          class="carousel__slide slide slide--{{ card_style }}"
          data-carousel-slide
          role="group"
          aria-roledescription="{{ 'carousel.slide' | t | downcase }}"
          aria-label="{{ 'carousel.slide_of' | t: current: forloop.index, total: section.blocks.size }}"
          {{ block.shopify_attributes }}
        >
          <div class="slide__media media media--{{ ratio }}">
            {%- if slide_image != blank -%}
              {{- slide_image | image_url: width: 1000 | image_tag: loading: slide_loading, widths: '320, 480, 640, 800, 1000', sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 85vw', class: 'slide__image', alt: '' -}}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if card_style == 'overlay' -%}
              <span class="slide__overlay" aria-hidden="true"></span>
            {%- endif -%}
          </div>

          <div class="slide__body">
            {%- if block.settings.title != blank -%}
              <{{ slide_heading }} class="slide__title heading heading--block">
                {%- if has_link and block.settings.link_label == blank -%}
                  <a class="slide__link" href="{{ block.settings.link }}"{% if new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ block.settings.title | escape }}</a>
                {%- else -%}
                  {{ block.settings.title | escape }}
                {%- endif -%}
              </{{ slide_heading }}>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="slide__text text-small">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.address != blank -%}
              <p class="slide__address text-small">
                {% render 'icon', name: 'pin', size: 16 %}
                <span>{{ block.settings.address | escape }}</span>
              </p>
            {%- endif -%}
            {%- if has_link and block.settings.link_label != blank -%}
              <a class="slide__cta button button--text text-nav" href="{{ block.settings.link }}"{% if new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                {%- if icon != 'none' and icon != blank -%}{% render 'icon', name: icon, size: 16 %}{%- endif -%}
                <span>{{ block.settings.link_label | escape }}</span>
                {%- if new_tab %}<span class="visually-hidden"> ({{ 'accessibility.opens_new_window' | t }})</span>{% endif -%}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}

      {%- unless has_slides -%}
        {%- for i in (1..slide_total) -%}
          <article class="carousel__slide slide slide--{{ card_style }}" data-carousel-slide>
            <div class="slide__media media media--{{ ratio }}">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          </article>
        {%- endfor -%}
      {%- endunless -%}
    </div>

    {%- if section.settings.show_arrows -%}
      <button class="carousel__button carousel__button--prev" type="button" data-carousel-prev aria-controls="track-{{ section.id }}" aria-label="{{ 'carousel.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 20 %}</button>
      <button class="carousel__button carousel__button--next" type="button" data-carousel-next aria-controls="track-{{ section.id }}" aria-label="{{ 'carousel.next' | t }}">{% render 'icon', name: 'chevron-right', size: 20 %}</button>
    {%- endif -%}
    {%- if section.settings.show_dots -%}
      <div class="carousel__dots" data-carousel-dots role="group" aria-label="{{ 'carousel.slides_nav' | t }}"></div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .slide { position: relative; display: flex; flex-direction: column; gap: var(--space-16); }
  .slide__image { transition: transform 0.6s var(--ease-out); }
  .slide__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-8); }
  .slide__title, .slide__text, .slide__address { margin: 0; }
  .slide__text { color: var(--scheme-text-muted); }
  .slide__address { display: flex; align-items: flex-start; gap: var(--space-8); }
  .slide__address .icon { margin-top: 2px; }
  .slide__link { text-decoration: none; }
  .slide__link::after { content: ""; position: absolute; inset: 0; z-index: 2; }
  .slide__link:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  .slide__cta { align-self: flex-start; display: inline-flex; align-items: center; gap: var(--space-8); }
  @media (hover: hover) { .slide:hover .slide__image { transform: scale(1.04); } }

  .slide--overlay { gap: 0; }
  .slide--overlay .slide__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0) 60%); }
  .slide--overlay .slide__body { position: absolute; inset: auto 0 0 0; z-index: 1; padding: var(--space-16); color: #fff; }
  .slide--overlay .slide__text { color: rgba(255, 255, 255, 0.85); }
  .slide--overlay .slide__cta { --scheme-focus: #fff; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.editorial-slideshow.name",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.editorial-slideshow.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:sections.editorial-slideshow.settings.heading_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.editorial-slideshow.settings.heading_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.editorial-slideshow.settings.heading_align.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.editorial-slideshow.settings.header__slides.content"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.editorial-slideshow.settings.card_style.label",
      "options": [
        {
          "value": "below",
          "label": "t:sections.editorial-slideshow.settings.card_style.options__1.label"
        },
        {
          "value": "overlay",
          "label": "t:sections.editorial-slideshow.settings.card_style.options__2.label"
        }
      ],
      "default": "below"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "t:sections.editorial-slideshow.settings.slides_per_view.label",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.editorial-slideshow.settings.image_ratio.label",
      "options": [
        {
          "value": "portrait",
          "label": "t:sections.editorial-slideshow.settings.image_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.editorial-slideshow.settings.image_ratio.options__2.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.editorial-slideshow.settings.image_ratio.options__3.label"
        },
        {
          "value": "wide",
          "label": "t:sections.editorial-slideshow.settings.image_ratio.options__4.label"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:sections.editorial-slideshow.settings.show_arrows.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "t:sections.editorial-slideshow.settings.show_dots.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.editorial-slideshow.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.editorial-slideshow.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.editorial-slideshow.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.editorial-slideshow.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.editorial-slideshow.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.editorial-slideshow.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.editorial-slideshow.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.editorial-slideshow.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.editorial-slideshow.settings.spacing_top.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.editorial-slideshow.settings.spacing_top.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.editorial-slideshow.settings.spacing_top.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.editorial-slideshow.settings.spacing_top.options__3.label"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.editorial-slideshow.settings.spacing_bottom.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.editorial-slideshow.settings.spacing_bottom.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.editorial-slideshow.settings.spacing_bottom.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.editorial-slideshow.settings.spacing_bottom.options__3.label"
        }
      ],
      "default": "full"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.editorial-slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.editorial-slideshow.blocks.slide.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.editorial-slideshow.blocks.slide.settings.title.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.editorial-slideshow.blocks.slide.settings.text.label"
        },
        {
          "type": "text",
          "id": "address",
          "label": "t:sections.editorial-slideshow.blocks.slide.settings.address.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.editorial-slideshow.blocks.slide.settings.link.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.editorial-slideshow.blocks.slide.settings.link_label.label",
          "info": "t:sections.editorial-slideshow.blocks.slide.settings.link_label.info"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.editorial-slideshow.blocks.slide.settings.icon.label",
          "options": [
            {
              "value": "none",
              "label": "t:sections.editorial-slideshow.blocks.slide.settings.icon.options__1.label"
            },
            {
              "value": "arrow-right",
              "label": "t:sections.editorial-slideshow.blocks.slide.settings.icon.options__2.label"
            },
            {
              "value": "pin",
              "label": "t:sections.editorial-slideshow.blocks.slide.settings.icon.options__3.label"
            },
            {
              "value": "external",
              "label": "t:sections.editorial-slideshow.blocks.slide.settings.icon.options__4.label"
            },
            {
              "value": "music",
              "label": "t:sections.editorial-slideshow.blocks.slide.settings.icon.options__5.label"
            },
            {
              "value": "play",
              "label": "t:sections.editorial-slideshow.blocks.slide.settings.icon.options__6.label"
            }
          ],
          "default": "none"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "t:sections.editorial-slideshow.blocks.slide.settings.open_new_tab.label",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.editorial-slideshow.presets.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
