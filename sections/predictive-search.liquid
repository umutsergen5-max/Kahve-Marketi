{%- comment -%}
  Predictive search results. Not placed in any template: assets/search.js
  requests it through Shopify's Predictive Search API
  (/search/suggest?section_id=predictive-search) and injects the markup into
  the search drawer.
{%- endcomment -%}
{%- liquid
  assign queries = predictive_search.resources.queries
  assign products = predictive_search.resources.products
  assign collections = predictive_search.resources.collections
  assign articles = predictive_search.resources.articles
  assign pages = predictive_search.resources.pages
  assign total = products.size | plus: collections.size | plus: articles.size | plus: pages.size | plus: queries.size
  assign terms = predictive_search.terms
  assign encoded_terms = terms | url_encode
  assign all_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options[prefix]=last'
-%}

<div id="predictive-search-results" data-predictive-results data-count="{{ total }}" data-announce="{% if total > 0 %}{{ 'search.results_announce' | t: count: total | escape }}{% else %}{{ 'search.no_results_short' | t | escape }}{% endif %}">
  {%- if predictive_search.performed -%}
    {%- if total == 0 -%}
      <p class="search-results__empty">{{ 'search.no_results' | t: terms: terms }}</p>
    {%- else -%}
      <div class="search-results">
        {%- assign resources_total = total | minus: products.size -%}
        {%- if resources_total > 0 -%}<div class="search-results__resources">{%- endif -%}
        {%- if queries.size > 0 -%}
          <section class="search-results__group" aria-labelledby="ps-queries">
            <h2 class="search-results__heading text-nav" id="ps-queries">{{ 'search.suggestions' | t }}</h2>
            <ul class="search-results__list" role="list">
              {%- for query in queries -%}
                <li><a class="search-results__link text-small" href="{{ query.url }}" data-result-link>{{ query.styled_text }}</a></li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

        {%- if collections.size > 0 -%}
          <section class="search-results__group" aria-labelledby="ps-collections">
            <h2 class="search-results__heading text-nav" id="ps-collections">{{ 'search.collections' | t }}</h2>
            <ul class="search-results__list" role="list">
              {%- for collection in collections -%}
                <li><a class="search-results__link text-small" href="{{ collection.url }}" data-result-link>{{ collection.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

        {%- if articles.size > 0 -%}
          <section class="search-results__group" aria-labelledby="ps-articles">
            <h2 class="search-results__heading text-nav" id="ps-articles">{{ 'search.articles' | t }}</h2>
            <ul class="search-results__list" role="list">
              {%- for article in articles -%}
                <li><a class="search-results__link text-small" href="{{ article.url }}" data-result-link>{{ article.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

        {%- if pages.size > 0 -%}
          <section class="search-results__group" aria-labelledby="ps-pages">
            <h2 class="search-results__heading text-nav" id="ps-pages">{{ 'search.pages' | t }}</h2>
            <ul class="search-results__list" role="list">
              {%- for page in pages -%}
                <li><a class="search-results__link text-small" href="{{ page.url }}" data-result-link>{{ page.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}
        {%- if resources_total > 0 -%}</div>{%- endif -%}

        {%- if products.size > 0 -%}
          <section class="search-results__group search-results__group--products" aria-labelledby="ps-products">
            <h2 class="search-results__heading text-nav" id="ps-products">{{ 'search.products' | t }}</h2>
            <div class="grid search-results__grid" style="--cols: 4; --cols-tablet: 3; --cols-mobile: 2; --gap-row: var(--space-32); --gap-column: var(--space-16);">
              {%- for product in products -%}
                {% render 'product-card',
                  product: product,
                  show_secondary_image: false,
                  show_quick_add: false,
                  sale_badge: 'none',
                  heading_tag: 'h3',
                  sizes: '(min-width: 1024px) 20vw, 40vw'
                %}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}
      </div>

      <p class="search-results__all">
        <a class="button button--secondary button--small" href="{{ all_url }}" data-result-link>{{ 'search.view_all_results' | t }}</a>
      </p>
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .search-results { display: flex; flex-direction: column; gap: var(--space-32); }
  @media (min-width: 768px) {
    .search-results { flex-direction: row; align-items: flex-start; }
    .search-results__resources { flex: none; width: 20%; min-width: 180px; }
  }
  .search-results__resources { display: flex; flex-direction: column; gap: var(--space-16); }
  .search-results__group--products { flex: 1; min-width: 0; width: 100%; order: 1; }
  @media (min-width: 768px) { .search-results__group--products { order: 0; } }
  .search-results__heading { margin: 0 0 var(--space-16); }
  .search-results__list { display: flex; flex-direction: column; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .search-results__link { display: inline-flex; align-items: center; min-height: 32px; text-decoration: none; font-weight: 700; }
  .search-results__link:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  .search-results__link mark { background: none; color: inherit; font-weight: 700; }
  .search-results__empty { padding: var(--space-16) 0; }
  .search-results__all { margin-top: var(--space-32); text-align: right; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.predictive-search.name"
}
{% endschema %}
