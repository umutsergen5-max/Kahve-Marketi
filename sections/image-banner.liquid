{%- comment -%}
  Image banner: a full-bleed row of large images, each with an optional centred overline,
  heading and call to action laid over it — meant as a closing band above the footer.
  Each slide is a block with its own image (and optional mobile crop) from the theme editor;
  without an image a placeholder is shown. A slide with a link is one big link and its
  label is presentational. Desktop: N slides side by side without gaps (default 2, each
  720:550); mobile: stacked, one per row.
{%- endcomment -%}
<section class="image-banner" style="--banner-cols: {{ section.settings.columns }};">
  <div class="image-banner__row">
    {%- for block in section.blocks -%}
      {%- liquid
        assign desktop_image = block.settings.image
        assign mobile_image = block.settings.mobile_image
        assign slide_tag = 'div'
        if block.settings.link != blank
          assign slide_tag = 'a'
        endif
        assign has_content = false
        if block.settings.overline != blank or block.settings.heading != blank or block.settings.button_label != blank
          assign has_content = true
        endif
      -%}
      <{{ slide_tag }}
        class="image-banner__slide image-banner__slide--text-{{ block.settings.text_color }}"
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="image-banner__media">
          {%- if desktop_image != blank -%}
            <picture>
              {%- if mobile_image != blank -%}
                <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 768 }} 768w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">
              {%- endif -%}
              <img
                class="image-banner__image"
                src="{{ desktop_image | image_url: width: 1200 }}"
                srcset="{{ desktop_image | image_url: width: 480 }} 480w, {{ desktop_image | image_url: width: 768 }} 768w, {{ desktop_image | image_url: width: 1100 }} 1100w, {{ desktop_image | image_url: width: 1600 }} 1600w"
                sizes="(min-width: 768px) calc(100vw / {{ section.settings.columns }}), 100vw"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
              >
            </picture>
          {%- else -%}
            <div class="image-banner__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
          <span class="image-banner__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }}" aria-hidden="true"></span>
        </div>

        {%- if has_content -%}
          <div class="image-banner__content">
            {%- if block.settings.overline != blank -%}
              <p class="overline image-banner__overline">{{ block.settings.overline | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="image-banner__heading heading heading--featured">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              {%- if section.settings.cta_style == 'link' -%}
                <span class="image-banner__link">{{ block.settings.button_label | escape }}</span>
              {%- else -%}
                <span class="button button--light image-banner__button">{{ block.settings.button_label | escape }}</span>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </{{ slide_tag }}>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .image-banner__row { display: grid; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 768px) { .image-banner__row { grid-template-columns: repeat(var(--banner-cols, 2), minmax(0, 1fr)); } }

  .image-banner__slide { position: relative; display: grid; overflow: hidden; aspect-ratio: 4 / 3; background: var(--color-background-dark); color: #fff; text-decoration: none; isolation: isolate; }
  @media (min-width: 768px) { .image-banner__slide { aspect-ratio: 720 / 550; } }
  .image-banner__slide > * { grid-area: 1 / 1; }

  .image-banner__media { position: relative; min-height: 0; }
  .image-banner__media picture, .image-banner__placeholder { position: absolute; inset: 0; display: block; }
  .image-banner__image, .image-banner__placeholder svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .image-banner__placeholder svg { opacity: 0.35; background: #3a3a3a; }
  .image-banner__overlay { position: absolute; inset: 0; background: #000; pointer-events: none; }
  a.image-banner__slide .image-banner__image { transition: transform 0.8s var(--ease-out); }
  @media (hover: hover) { a.image-banner__slide:hover .image-banner__image { transform: scale(1.03); } }
  a.image-banner__slide:focus-visible { outline: 2px solid currentColor; outline-offset: -4px; }

  .image-banner__content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-8); padding: var(--space-32) var(--section-x); text-align: center; }
  .image-banner__overline, .image-banner__heading { margin: 0; max-width: 40rem; }
  .image-banner__overline { letter-spacing: 1.5px; }
  .image-banner__button { margin-top: var(--space-8); }
  .image-banner__link { display: inline-block; margin-top: var(--space-8); padding-bottom: 3px; font-family: var(--font-body-family); font-weight: var(--font-nav-weight); font-size: var(--fs-nav); letter-spacing: 1px; line-height: 1; text-transform: var(--tt-ui); background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat; }
  @keyframes image-banner-draw-line { from { background-size: 0 1px; } to { background-size: 100% 1px; } }
  @media (hover: hover) { a.image-banner__slide:hover .image-banner__link { animation: image-banner-draw-line 0.4s var(--ease-standard); } }

  .image-banner__slide--text-dark { color: var(--color-background-dark); }
  .image-banner__slide--text-dark .image-banner__overlay { background: #fff; }
  .image-banner__slide--text-dark .button--light { --button-bg: var(--color-background-dark); --button-text: #fff; --button-border: var(--color-background-dark); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.image-banner.settings.columns.label",
      "info": "t:sections.image-banner.settings.columns.info",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "t:sections.image-banner.settings.cta_style.label",
      "options": [
        {
          "value": "button",
          "label": "t:sections.image-banner.settings.cta_style.options__1.label"
        },
        {
          "value": "link",
          "label": "t:sections.image-banner.settings.cta_style.options__2.label"
        }
      ],
      "default": "link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.image-banner.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image-banner.blocks.slide.settings.image.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.image-banner.blocks.slide.settings.mobile_image.label"
        },
        {
          "type": "text",
          "id": "overline",
          "label": "t:sections.image-banner.blocks.slide.settings.overline.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.image-banner.blocks.slide.settings.heading.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.image-banner.blocks.slide.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.image-banner.blocks.slide.settings.link.label",
          "info": "t:sections.image-banner.blocks.slide.settings.link.info"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:sections.image-banner.blocks.slide.settings.overlay_opacity.label",
          "default": 30,
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "t:sections.image-banner.blocks.slide.settings.text_color.label",
          "options": [
            {
              "value": "light",
              "label": "t:sections.image-banner.blocks.slide.settings.text_color.options__1.label"
            },
            {
              "value": "dark",
              "label": "t:sections.image-banner.blocks.slide.settings.text_color.options__2.label"
            }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-banner.presets.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
