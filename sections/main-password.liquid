{%- comment -%}
  Password page (password template, layout/password.liquid): shown while the store is
  password-protected. Brand comes from the centralized settings (logo, or the brand name as
  text); the message is Shopify's own password message (Settings > Preferences) with a
  theme-editor text as fallback. Native storefront_password form, optional email capture through
  Shopify's customer form, and an optional "store owner" link. No launch date is invented.
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign heading_text = section.settings.heading
  if heading_text == blank
    assign heading_text = 'password.title' | t
  endif
  assign message_text = shop.password_message
-%}
<section class="password-page scheme-{{ section.settings.color_scheme }}">
  <div class="password-page__inner">
    <div class="password-page__brand">
      {%- if settings.logo != blank -%}
        {% render 'image', image: settings.logo, widths: '200, 400, 600', sizes: '240px', loading: 'eager', fetchpriority: 'high', alt: brand %}
      {%- else -%}
        <p class="password-page__wordmark heading heading--featured">{{ brand | escape }}</p>
      {%- endif -%}
    </div>

    <h1 class="password-page__title heading heading--section">{{ heading_text | escape }}</h1>
    {%- if message_text != blank -%}
      <div class="password-page__message rte">{{ message_text }}</div>
    {%- elsif section.settings.text != blank -%}
      <div class="password-page__message rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div class="password-page__signup">
        <h2 class="password-page__subtitle heading heading--block" id="password-signup-title">{{ 'password.signup_title' | t }}</h2>
        {%- form 'customer', id: 'password-signup', novalidate: 'novalidate' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="message message--success" role="status" tabindex="-1">{{ 'password.signup_success' | t }}</p>
          {%- else -%}
            {% render 'form-errors', errors: form.errors, id: 'password-signup-errors' %}
            <div class="password-page__row">
              {% render 'form-field', id: 'password-signup-email', name: 'contact[email]', type: 'email', label_key: 'newsletter.email_label', value: form.email, autocomplete: 'email', is_required: true, errors: form.errors, field: 'email', summary_id: 'password-signup-errors' %}
              <button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <details class="password-page__enter" {% if form.errors %}open{% endif %}>
      <summary class="button button--secondary">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', id: 'password-form', novalidate: 'novalidate' -%}
        {% render 'form-errors', errors: form.errors, id: 'password-form-errors' %}
        {% render 'form-field', id: 'storefront-password', name: 'password', type: 'password', label_key: 'password.label', autocomplete: 'current-password', is_required: true, errors: form.errors, field: 'password', summary_id: 'password-form-errors', autofocus: false %}
        <button class="button" type="submit">{{ 'password.submit' | t }}</button>
      {%- endform -%}
    </details>

    {%- if section.settings.show_owner_link -%}
      <p class="password-page__owner text-small"><a class="link" href="{{ shop.url }}/admin">{{ 'password.owner_login' | t }}</a></p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .password-page { display: flex; min-height: 100vh; align-items: center; justify-content: center; padding: var(--section-y) var(--section-x); }
  .password-page__inner { display: flex; flex-direction: column; align-items: center; gap: var(--space-16); width: 100%; max-width: var(--width-xs); text-align: center; }
  .password-page__brand img { max-width: min(240px, 70vw); height: auto; }
  .password-page__wordmark, .password-page__title, .password-page__subtitle { margin: 0; }
  .password-page__message { max-width: 32rem; }
  .password-page__signup, .password-page__enter { width: 100%; text-align: left; }
  .password-page__signup .password-page__subtitle { text-align: center; margin-bottom: var(--space-12); }
  .password-page__signup form, .password-page__enter form { display: flex; flex-direction: column; gap: var(--space-16); margin-top: var(--space-16); }
  .password-page__row { display: flex; flex-direction: column; gap: var(--space-12); align-items: stretch; }
  .password-page__enter > summary { display: flex; width: 100%; cursor: pointer; list-style: none; }
  .password-page__enter > summary::-webkit-details-marker { display: none; }
  .password-page__enter > summary:focus-visible { outline: 2px solid var(--scheme-focus); outline-offset: 2px; }
  .password-page__enter .button[type="submit"] { align-self: flex-start; }
  .password-page__owner { margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-password.name",
  "enabled_on": {
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main-password.settings.heading.label",
      "info": "t:sections.main-password.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.main-password.settings.text.label",
      "info": "t:sections.main-password.settings.text.info"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main-password.settings.show_newsletter.label",
      "info": "t:sections.main-password.settings.show_newsletter.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_owner_link",
      "label": "t:sections.main-password.settings.show_owner_link.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main-password.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.main-password.settings.color_scheme.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.main-password.settings.color_scheme.options__1.label"
        },
        {
          "value": "light",
          "label": "t:sections.main-password.settings.color_scheme.options__2.label"
        },
        {
          "value": "dark",
          "label": "t:sections.main-password.settings.color_scheme.options__3.label"
        },
        {
          "value": "accent-1",
          "label": "t:sections.main-password.settings.color_scheme.options__4.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.main-password.settings.color_scheme.options__5.label"
        },
        {
          "value": "accent-3",
          "label": "t:sections.main-password.settings.color_scheme.options__6.label"
        }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
