{%- comment -%}
  Site-level JSON-LD.
  - Home page: WebSite + sitelinks search box.
  - Product page: Product with one Offer per variant (price, currency, availability, SKU,
    GTIN from the barcode) and a BreadcrumbList. Everything is read from Shopify objects;
    no ratings or reviews are ever invented. The canonical URL comes from the layout.
  - Article page: BlogPosting (headline, image, author, datePublished, dateModified).
  - Blog page: Blog with its listed BlogPosting entries.
  Values come from Shopify objects and are left out when missing; nothing is invented.
{%- endcomment -%}
{%- assign brand = settings.brand_name | default: shop.name -%}
{%- if template.name == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ brand | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ routes.search_url | prepend: shop.url }}?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- elsif template.name == 'product' and product -%}
  {%- liquid
    assign ld_variant = product.selected_or_first_available_variant
    assign ld_description = product.description | strip_html | strip_newlines | strip
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ canonical_url | json }},
      {%- if ld_description != blank %}
      "description": {{ ld_description | json }},
      {%- endif %}
      {%- if product.vendor != blank %}
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      {%- endif %}
      {%- if ld_variant.sku != blank %}
      "sku": {{ ld_variant.sku | json }},
      {%- endif %}
      {%- if product.images.size > 0 %}
      "image": [
        {%- for image in product.images limit: 5 -%}
          {%- assign ld_image = image | image_url: width: 1200 -%}
          {%- unless ld_image contains 'https:' %}{% assign ld_image = ld_image | prepend: 'https:' %}{% endunless -%}
          {{ ld_image | json }}{% unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      ],
      {%- endif %}
      "offers": [
        {%- for variant in product.variants -%}
          {%- liquid
            assign ld_offer_url = canonical_url | append: '?variant=' | append: variant.id
            assign ld_price = variant.price | divided_by: 100.0
          -%}
          {
            "@type": "Offer",
            "url": {{ ld_offer_url | json }},
            "price": {{ ld_price | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
            {%- if variant.sku != blank %}
            "sku": {{ variant.sku | json }},
            {%- endif %}
            {%- if variant.barcode != blank %}
            "gtin": {{ variant.barcode | json }},
            {%- endif %}
            "itemCondition": "https://schema.org/NewCondition"
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ routes.root_url | prepend: shop.url | json }} }
        {%- if collection -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: shop.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
        {%- else -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }
        {%- endif -%}
      ]
    }
  </script>
{%- elsif template.name == 'article' and article -%}
  {%- liquid
    assign ld_excerpt = article.excerpt_or_content | strip_html | strip_newlines | strip | truncatewords: 40
    assign ld_article_image = nil
    if article.image
      assign ld_article_image = article.image | image_url: width: 1200
      unless ld_article_image contains 'https:'
        assign ld_article_image = ld_article_image | prepend: 'https:'
      endunless
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ article.title | json }},
      "url": {{ canonical_url | json }},
      "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} },
      {%- if ld_excerpt != blank %}
      "description": {{ ld_excerpt | json }},
      {%- endif %}
      {%- if ld_article_image %}
      "image": [{{ ld_article_image | json }}],
      {%- endif %}
      {%- if article.author != blank %}
      "author": { "@type": "Person", "name": {{ article.author | json }} },
      {%- endif %}
      {%- if article.tags.size > 0 %}
      "keywords": {{ article.tags | join: ', ' | json }},
      {%- endif %}
      "publisher": { "@type": "Organization", "name": {{ brand | json }} },
      {%- if article.updated_at %}
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
      {%- endif %}
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }}
    }
  </script>
{%- elsif template.name == 'blog' and blog -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": {{ blog.title | json }},
      "url": {{ blog.url | prepend: shop.url | json }},
      "blogPost": [
        {%- for item in blog.articles limit: 10 -%}
          {
            "@type": "BlogPosting",
            "headline": {{ item.title | json }},
            "url": {{ item.url | prepend: shop.url | json }},
            "datePublished": {{ item.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
