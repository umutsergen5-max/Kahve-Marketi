{%- comment -%}
  Inline icon. Decorative by default (aria-hidden); pair with visible or
  visually-hidden text. All glyphs are simple original line drawings.

  Accepts:
  - name: search | bag | user | menu | close | chevron-down | chevron-left | chevron-right | plus | minus
          | arrow-right | check | pause | play | pin | external | music | grid-large | grid-small | filter | share | eye | eye-off | copy | print | download | instagram | facebook | x | youtube | tiktok | pinterest
  - size: pixel size (default 20)
  - class: extra CSS classes

  Usage: {% render 'icon', name: 'close' %}
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 20
-%}
<svg class="icon icon--{{ name }}{% if class != blank %} {{ class }}{% endif %}" style="--icon-size: {{ icon_size }}px" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
    {%- when 'bag' -%}<path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V7a3 3 0 016 0v1"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4.5 20c.8-3.6 3.7-5.5 7.5-5.5s6.7 1.9 7.5 5.5"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'chevron-down' -%}<path d="M6 9l6 6 6-6"/>
    {%- when 'chevron-left' -%}<path d="M15 6l-6 6 6 6"/>
    {%- when 'chevron-right' -%}<path d="M9 6l6 6-6 6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'arrow-right' -%}<path d="M4 12h16M14 6l6 6-6 6"/>
    {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'pause' -%}<path d="M9 6v12M15 6v12"/>
    {%- when 'play' -%}<path d="M8 5.5v13l10-6.5z"/>
    {%- when 'pin' -%}<path d="M12 21s-6-5.400-6-10a6 6 0 1112 0c0 4.600-6 10-6 10z"/><circle cx="12" cy="11" r="2.200"/>
    {%- when 'external' -%}<path d="M14 5h5v5M19 5l-8 8M17 13v5a1 1 0 01-1 1H6a1 1 0 01-1-1V8a1 1 0 011-1h5"/>
    {%- when 'music' -%}<path d="M9 18V6l10-2v12"/><circle cx="6.500" cy="18" r="2.500"/><circle cx="16.500" cy="16" r="2.500"/>
    {%- when 'grid-large' -%}<rect x="4" y="4" width="7" height="16" rx="1"/><rect x="13" y="4" width="7" height="16" rx="1"/>
    {%- when 'grid-small' -%}<rect x="3.500" y="4" width="4" height="7" rx="0.800"/><rect x="10" y="4" width="4" height="7" rx="0.800"/><rect x="16.500" y="4" width="4" height="7" rx="0.800"/><rect x="3.500" y="13" width="4" height="7" rx="0.800"/><rect x="10" y="13" width="4" height="7" rx="0.800"/><rect x="16.500" y="13" width="4" height="7" rx="0.800"/>
    {%- when 'filter' -%}<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>
    {%- when 'share' -%}<circle cx="18" cy="5.500" r="2.500"/><circle cx="6" cy="12" r="2.500"/><circle cx="18" cy="18.500" r="2.500"/><path d="M8.200 10.800l7.600-4.200M8.200 13.200l7.600 4.200"/>
    {%- when 'eye' -%}<path d="M2.500 12S6 5.500 12 5.500 21.500 12 21.500 12 18 18.500 12 18.500 2.500 12 2.500 12z"/><circle cx="12" cy="12" r="3"/>
    {%- when 'eye-off' -%}<path d="M3 3l18 18M10.200 5.700A9 9 0 0112 5.500c6 0 9.500 6.500 9.500 6.500a15 15 0 01-2.700 3.400M6.500 7.100A15 15 0 002.500 12S6 18.500 12 18.500a9 9 0 003.700-.8"/><path d="M9.900 9.900a3 3 0 004.200 4.200"/>
    {%- when 'copy' -%}<rect x="8.500" y="8.500" width="11" height="11" rx="1.500"/><path d="M15.500 8.500v-3a1 1 0 00-1-1h-9a1 1 0 00-1 1v9a1 1 0 001 1h3"/>
    {%- when 'print' -%}<path d="M7 9V4.500h10V9M7 17H4.500V9.500h15V17H17"/><rect x="7" y="14" width="10" height="6" rx="0.500"/>
    {%- when 'download' -%}<path d="M12 4.500v11M7.500 11.500l4.500 4.500 4.500-4.500M5 19.500h14"/>
    {%- when 'instagram' -%}<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><path d="M16.9 7.1h.01"/>
    {%- when 'facebook' -%}<path d="M14.5 21v-8h2.8l.5-3.3h-3.3V7.6c0-1 .5-1.7 1.8-1.7h1.6V3.2A19 19 0 0015.5 3c-2.4 0-4 1.5-4 4.100v2.6H9V13h2.500v8"/>
    {%- when 'x' -%}<path d="M4.500 4.500h3.800l11.200 15h-3.800z"/><path d="M19 4.500l-6.800 7.300M4.800 19.500l6.900-7.400"/>
    {%- when 'youtube' -%}<rect x="3" y="6" width="18" height="12" rx="4"/><path d="M10 9.500v5l4.500-2.500z"/>
    {%- when 'tiktok' -%}<path d="M14 4v10.200a3.700 3.700 0 11-3.700-3.700"/><path d="M14 4c.3 2.400 1.800 4 4.500 4.300"/>
    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="8.500"/><path d="M11 16.500L12.6 9c.6-1.200 2.700-.9 2.700 1 0 1.800-1.400 3.100-2.700 3.100-.9 0-1.5-.5-1.5-1.300"/>
  {%- endcase -%}
</svg>
