{%- comment -%}
  Standard, accessible pagination for any the paginate tag block (collections, collection
  list, and later search / blog). Shopify's own URLs keep the active filters and sorting.

  Accepts:
  - paginate: the paginate object (required)
  - class: extra CSS classes
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  {%- assign current_label = paginate.current_page | append: '' -%}
  <nav class="pagination{% if class != blank %} {{ class }}{% endif %}" aria-label="{{ 'pagination.label' | t }}">
    <ul class="pagination__list" role="list">
      {%- if paginate.previous -%}
        <li>
          <a class="pagination__link pagination__link--step" href="{{ paginate.previous.url }}" rel="prev">
            {% render 'icon', name: 'chevron-left', size: 16 %}
            <span class="pagination__step-text text-nav">{{ 'pagination.previous' | t }}</span>
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}" aria-label="{{ 'pagination.page_label' | t: number: part.title }}">{{ part.title }}</a>
          {%- elsif part.title == current_label -%}
            <span class="pagination__link is-current" aria-current="page" aria-label="{{ 'pagination.current_page' | t: number: part.title }}">{{ part.title }}</span>
          {%- else -%}
            <span class="pagination__gap" aria-hidden="true">&hellip;</span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a class="pagination__link pagination__link--step" href="{{ paginate.next.url }}" rel="next">
            <span class="pagination__step-text text-nav">{{ 'pagination.next' | t }}</span>
            {% render 'icon', name: 'chevron-right', size: 16 %}
          </a>
        </li>
      {%- endif -%}
    </ul>
    <p class="visually-hidden">{{ 'pagination.page_of' | t: current: paginate.current_page, total: paginate.pages }}</p>
  </nav>
{%- endif -%}

{% stylesheet %}
  .pagination { display: flex; justify-content: center; margin-top: var(--space-48); }
  .pagination__list { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .pagination__link, .pagination__gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    min-width: 44px;
    height: 44px;
    padding: 0 var(--space-12);
    border-radius: var(--radius-button);
    color: inherit;
    font-family: var(--font-body-family);
    font-weight: var(--font-nav-weight);
    text-decoration: none;
  }
  a.pagination__link { border: 1px solid transparent; transition: border-color 0.2s var(--ease-standard); }
  @media (hover: hover) { a.pagination__link:hover { border-color: var(--color-border-strong); } }
  .pagination__link.is-current { border: 1px solid var(--scheme-text); }
  .pagination__link--step { border-color: var(--color-border-strong); }
  @media (max-width: 500px) { .pagination__step-text { display: none; } }
{% endstylesheet %}
