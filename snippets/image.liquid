{%- comment -%}
  Responsive image helper built on Shopify's image_tag (srcset generated by
  Shopify's image CDN — no pre-sized files are stored in the theme).

  Accepts:
  - image: image object (required; a placeholder is rendered when blank)
  - sizes: sizes attribute (default: 100vw)
  - widths: comma-separated srcset widths
  - loading: lazy (default) | eager
  - fetchpriority: auto | high | low
  - class: CSS class(es) for the <img>
  - alt: override alt text; pass '' for decorative images (defaults to the image's own alt)
  - placeholder: placeholder_svg_tag name shown when image is blank (default: image)

  Usage: {% render 'image', image: section.settings.image, sizes: '(min-width: 768px) 50vw, 100vw' %}
{%- endcomment -%}
{%- liquid
  assign img_loading = loading | default: 'lazy'
  assign img_widths = widths | default: '200, 400, 600, 800, 1000, 1200, 1600, 2000'
  assign img_sizes = sizes | default: '100vw'
  if alt != nil
    assign img_alt = alt | escape
  else
    assign img_alt = image.alt | escape
  endif
-%}
{%- if image != blank -%}
  {{- image | image_url: width: 2000 | image_tag: loading: img_loading, widths: img_widths, sizes: img_sizes, class: class, alt: img_alt, fetchpriority: fetchpriority -}}
{%- else -%}
  {{- placeholder | default: 'image' | placeholder_svg_tag: 'placeholder-svg' -}}
{%- endif -%}
