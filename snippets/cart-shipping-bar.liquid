{%- comment -%}
  Free-shipping progress: message + progress bar, driven by settings.free_shipping_threshold
  (in the shop currency's major unit). Renders nothing when no threshold is set.
  Shared by the cart drawer and the cart page.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign shipping_message = ''
  assign percent = 0
  if threshold > 0
    assign remaining = threshold | minus: cart.total_price
    if remaining > 0
      assign remaining_money = remaining | money
      assign shipping_message = 'cart.free_shipping_remaining' | t: amount: remaining_money
      assign percent = cart.total_price | times: 100.0 | divided_by: threshold | round
    else
      assign shipping_message = 'cart.free_shipping_reached' | t
      assign percent = 100
    endif
  endif
-%}
{%- if threshold > 0 -%}
  <div class="cart-shipping">
    <p class="cart-shipping__message text-small">{{ shipping_message }}</p>
    <div class="cart-shipping__bar" role="progressbar" aria-label="{{ 'cart.free_shipping_progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent }}">
      <span class="cart-shipping__fill" style="width: {{ percent }}%"></span>
    </div>
  </div>
{%- endif -%}
