<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent_1 }}">
    {%- assign brand = settings.brand_name | default: shop.name -%}
    <title>{{ brand | escape }}{% if page_title != blank and page_title != brand %} – {{ page_title | escape }}{% endif %}</title>
    {%- if page_description != blank %}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif %}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    <meta property="og:site_name" content="{{ brand | escape }}">
    <meta property="og:title" content="{{ page_title | default: brand | escape }}">
    <meta property="og:type" content="website">

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
    <script src="{{ 'auth.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handleize }}" data-template="{{ template.name }}">
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
